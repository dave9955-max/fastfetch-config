  
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/pic/tree2.png",
    	"type": "kitty",
      	"height": 20,
      	"padding": {
    		"top": 1
      	}
    },
    "display": {
          "separator": " ➜  "
    },
    "modules": [
        "break",
        "break",
        "break",
         {
            "type": "os",
            "key": "OS  ",
            "keyColor": "31",  // = color1
        },

        {
   "type": "command",
   "key": " ├  ",
   "keyColor": "31",
   "text":"birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install));          days_difference=$((time_progression / 86400)); echo Age: $days_difference days"
       },

        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "31",
        },
        {
            "type": "packages",
            "format": "{rpm} (packages)",
            "key": " ├  ",
            "keyColor": "31",
        },
         {
            "type": "packages",
            "format": "{flatpak-all} (flatpak)",
            "key": " ├  ",
            "keyColor": "31",
        },
        {
            "type": "shell",
            "key": " ├  ",
            "keyColor": "31", 
        },
        "break",
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "32", 
        },
        {
            "type": "wmtheme",
            "key": " ├  ",
            "keyColor": "32",
        },
        {
            "type": "icons",
            "key": " ├  ",
            "keyColor": "32",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "32", 
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "32",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "32", 
        },
        "break",
        {
            "type": "host",
            "key": "PC  ",
            "keyColor": "33",
        },
        {
            "type": "cpu",
            "format":"{1} ({3}) @ {7}",
            "key": " ├  ",
            "keyColor": "33",
        },
      {
            "type": "gpu",
            "driverSpecific": true,
            "format": "{2} @ {frequency}",
            "key": " ├  ",
            "keyColor": "33"
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "33",
        },
        {
            "type": "disk",
            "key": " ├  ",
            "keyColor": "33",
        },
        {
           },
        "break",
        "break",
    ]
}
